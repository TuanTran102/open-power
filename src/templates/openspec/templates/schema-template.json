{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "DataModelSchema",
  "description": "Standard OpenSpec JSON schema template for data validation",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "required": [
    "id",
    "name",
    "createdAt"
  ],
  "additionalProperties": false
}
